# =============================================================================
# Mastra Agentic Environment
# Skopiuj ten plik do .env i uzupełnij wartości.
# =============================================================================

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Lokalna instancja: mongodb://localhost:27017/agentforge
# Atlas:             mongodb+srv://user:pass@cluster.mongodb.net/agentforge
# Mongo dziala jako single-node replica set (rs0) — patrz docker-compose.yml.
# Transakcje wielodokumentowe (wymagane przez orkiestracje V2) NIE dzialaja na
# standalone, dlatego `?replicaSet=rs0` jest czescia URI takze w dev.
MONGODB_URI=mongodb://localhost:27017/agentforge?replicaSet=rs0

# Orkiestracja V2 (domyslnie OFF). Wlaczenie wymaga replica setu — patrz
# agentic-agents/ideas/plan-dziecko-po-odlozeniu-g0.md
# FEATURE_ORCHESTRATION_V2=true
# MONGODB_URI_V2=mongodb://localhost:27017/agentforge_v2?replicaSet=rs0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Lokalna baza obserwowalności Mastra. Musi pozostawać poza src/mastra/public,
# ponieważ zawartość public jest kopiowana w całości do każdego builda.
MASTRA_DUCKDB_PATH=storage/mastra-observability.duckdb

# ── Google / Gemini (LLM + Gmail + Calendar) ─────────────────────────────────
# Gemini API — https://aistudio.google.com/app/apikey
# Modele tekstowe: gemini-3.7-flash, gemini-3.6-flash,
# gemini-3.5-flash, gemini-3.5-flash-lite.
GOOGLE_GENERATIVE_AI_API_KEY=
# Alias dla starszych integracji (ta sama wartość co GOOGLE_GENERATIVE_AI_API_KEY)
GOOGLE_API_KEY=

# ── Alex Live (głos ⇄ istniejący Jarvis Meta, domyślnie całkowicie OFF) ────────
# Po zmianie flagi zrestartuj Mastrę. Klucz Gemini pozostaje wyłącznie na serwerze;
# przeglądarka dostaje jednorazowy token efemeryczny ograniczony do tej konfiguracji.
FEATURE_ALEX_LIVE=false
ALEX_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
ALEX_GEMINI_VOICE=Charon
ALEX_META_RESOURCE_ID=alex-local-user

# OAuth2 – potrzebne do Gmail i Calendar (credentials.json z Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# refresh token uzyskany po jednorazowej autoryzacji OAuth2
GOOGLE_REFRESH_TOKEN=

# ── Anthropic (Claude, OPCJONALNE) ────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── OpenAI (GPT, OPCJONALNE) ──────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── OpenRouter (multi-model router, OPCJONALNE) ──────────────────────────────
# https://openrouter.ai/keys — aktywuje OpenRouterGateway.
OPENROUTER_API_KEY=

# ── Groq Cloud (workery text-only, WYMAGANE dla system_run_worker) ────────────
# https://console.groq.com/keys — aktywuje GroqGateway.
# Produkcyjne presety workerów używają openai/gpt-oss-20b i -120b.
GROQ_API_KEY=

# ── DeepSeek (LLM, OpenAI-compatible) ─────────────────────────────────────────
# https://platform.deepseek.com/api_keys — aktywuje DeepSeekGateway.
# Modele: deepseek-v4-flash (tani, high-volume), deepseek-v4-pro (mocniejszy).
# Bez klucza gateway jest pomijany przy starcie Mastry.
DEEPSEEK_API_KEY=

# ── ZenMux (AI model aggregator, OpenAI-compatible) ───────────────────────────
# https://zenmux.ai — agregator modeli AI z PAYG billing.
# Modele: moonshotai/kimi-k3-free ($0/$0, rate-limited, tymczasowe).
# Base URL: https://zenmux.ai/api/v1. Min. doładowanie $5 (saldo PAYG).
# Bez klucza gateway jest pomijany przy starcie Mastry.
ZENMUX_API_KEY=

# ── ElevenLabs (TTS, OPCJONALNE) ──────────────────────────────────────────────
# https://elevenlabs.io — text-to-speech dla audio contentów.
ELEVENLABS_API_KEY=

# ── n8n ───────────────────────────────────────────────────────────────────────
# Adres UI n8n (panel), np. http://localhost:5678
N8N_URL=http://localhost:5678
# Adres API n8n (używany przez narzędzia do REST calls)
N8N_BASE_URL=http://localhost:5678
# API Key z n8n → Settings → API Keys
N8N_API_KEY=

# n8n MCP helper for Automation Architect.
# MVP default: disabled + readonly. When enabled, Mastra starts `npx -y n8n-mcp`
# for documentation/template/node validation tools only. Keep N8N_MCP_MODE=readonly
# unless you intentionally test post-MVP management capabilities in a dev n8n.
FEATURE_N8N_MCP=false
N8N_MCP_ENABLED=false
N8N_MCP_MODE=readonly
N8N_MCP_LOG_LEVEL=error
N8N_MCP_ENGINEER_DELEGATION_MAX_STEPS=20
N8N_MCP_VALIDATE_WORKFLOW_MODE=advisory
# Only used when N8N_MCP_MODE=management; do not enable for MVP production work.
N8N_MCP_WEBHOOK_SECURITY_MODE=moderate

# Automation semantic coverage gate.
# off = disabled, warn = report only, block = block critical pattern gaps before deploy.
AUTOMATION_COVERAGE_GATE_MODE=warn
AUTOMATION_COVERAGE_MIN_SCORE=1

# Smoke test cleanup. false deletes temporary smoke workflows after checks.
KEEP_SMOKE_WORKFLOWS=false

# ── Cloudflare Tunnel (auto-managed) ─────────────────────────────────────────
# Ponizsze 5 zmiennych nadpisuje skrypt agentic-agents/scripts/n8n-tunnel-up.sh
# (uruchamiany z `npm run dev` / `npm run start` / `npm run tunnel:up`).
# Skrypt czyta swiezy URL z kontenera af-cloudflared-n8n i restartuje n8n.
# Reczne ustawienie tych wartosci nie ma sensu — zostana nadpisane.
N8N_PUBLIC_WEBHOOK_BASE_URL=https://replace-me.trycloudflare.com
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PROXY_HOPS=0

# ── Runtime Topology ──────────────────────────────────────────────────────────
# local-host-network = n8n dziala lokalnie/host-network i widzi localhost hosta.
# docker-compose-network = n8n dziala w tej samej sieci compose i wymaga nazw serwisow.
RUNTIME_MODE=local-host-network
MASTRA_STUDIO_URL=http://localhost:4111
MASTRA_API_URL_FOR_N8N=http://localhost:4111
OLLAMA_BASE_URL_FOR_N8N=http://localhost:11434
MONGO_HOST_FOR_N8N=localhost:27017
MONGO_DB_NAME=agentforge

# ── Dashboard Analytics V2 ───────────────────────────────────────────────────
# Short in-memory cache for read-only dashboard aggregations.
# Set TTL to 0 to disable. Keep short because live telemetry changes frequently.
DASHBOARD_V2_CACHE_TTL_MS=15000
DASHBOARD_V2_CACHE_MAX_ENTRIES=250

# ── DuckDB observability retention ──────────────────────────────────────────
# Rolling window in calendar days. The server performs cleanup in-process at
# 02:10, because a second process cannot take DuckDB's writer lock.
OBSERVABILITY_RETENTION_ENABLED=true
OBSERVABILITY_RETENTION_DAYS=3
# Required shared Bearer secret for the maintenance endpoint and cron runner.
# Generate locally, for example: openssl rand -hex 32
OBSERVABILITY_RETENTION_TOKEN=

# Unset by default = POST /dashboard/approvals/:id/approve accepts any request
# (today's behaviour, matches "dashboard is local-only"). Set this to require
# `Authorization: Bearer <token>` on that endpoint before exposing the
# dashboard beyond localhost — approving a pending request is what lets
# capability_attach add a new MCP server, coding_apply_patch merge into the
# live repo, or a paid tool actually run.
# DASHBOARD_APPROVAL_TOKEN=

# ── Mastra Harness / jcode-inspired memory flags ─────────────────────────────
# Runtime switches for the additive harness rollout. Set a flag to false to
# return that layer to the previous flow while leaving other stages enabled.
FEATURE_CODING_PRECONTEXT=true
FEATURE_REVIEW_PRECONTEXT=true
FEATURE_AUTOMATION_PRECONTEXT=true
FEATURE_KNOWLEDGE_PRECONTEXT=true
FEATURE_ASYNC_SEMANTIC_MEMORY=true
FEATURE_FILE_ACTIVITY_LEDGER=true
FEATURE_CODE_OUTLINE=true
FEATURE_BACKGROUND_TASKS=true
FEATURE_SOFT_INTERRUPTS=true
FEATURE_MASTRA_HARNESS=true
FEATURE_TOOL_ENVELOPE=true
FEATURE_OUTPUT_COMPACTION=true
FEATURE_HARNESS_POLICY=true
# log_only = warning/log-only; enforce = block actions that policy rejects.
HARNESS_POLICY_MODE=log_only
FEATURE_HARNESS_REPLAY=true
# Reflektor Part 1: in-flight prepareStep intervention (reflection reaches model BEFORE the next step)
FEATURE_REFLECTOR_PREPARE_STEP=true
# Reflektor Part 2: GoalContract-aware triggers (progress_stall + wrong_tool)
FEATURE_REFLECTOR_GOAL_TRIGGERS=true
# Reflektor Part 2: hard levers (escalateModel / forceTool / restrictTools)
FEATURE_REFLECTOR_HARD_LEVERS=true
# Reflektor Part 2: custom stopWhen → early escalation when unrecoverable
FEATURE_REFLECTOR_STOP_WHEN=true
# Reflektor Part 2: native isTaskComplete output scoring (GoalContract scorer)
FEATURE_OUTPUT_SCORING=true
# Reflektor Part 3: pipeline-mode reflector for chef/content/hunt (per-phase, soft levers only)
FEATURE_PIPELINE_REFLECTOR=true
# Reflektor Part 3: per-phase activeTools allowlist (chef/content/hunt + automation Golden Path)
FEATURE_PIPELINE_PHASE_TOOLS=true
# WS2: LLM-authored delegation plan (assumptions + per-step successCheck) into GoalContract + replan-on-failure.
# Default OFF. automationArchitect always bypasses this planner because Golden Path owns its plan.
FEATURE_DELEGATION_LLM_PLAN=false
# WS-A/WS-D: budget for automationArchitect build delegations (sync + async), ms.
# A build (compose+deploy+mock test+bounded repair) can exceed the generic 240s.
# 1200s gives headroom for complex builds (MCP handoff + many nodes + repair).
# The harness now ABORTS the underlying generation when this fires (no zombie run).
# For builds you don't want to block on, prefer FEATURE_AUTOMATION_ASYNC_DEFAULT over a higher wall.
DELEGATION_AUTOMATION_TIMEOUT_MS=1200000
# WS-B: route automationArchitect BUILD delegations (not read-only analysis) to the
# async path by default, so meta returns "build started" immediately and the result
# arrives as a pending update. Off by default — the sync path + WS-C stop-on-terminal
# already returns fast. Turn on if you prefer non-blocking builds.
FEATURE_AUTOMATION_ASYNC_DEFAULT=false
# WS-G: fail-closed gate — after a FAILED mandatory n8n MCP handoff, the Golden Path
# deploy is blocked (node configs are unvalidated) until a successful handoff clears
# it or the architect reports blocked. On by default; set false to disable.
FEATURE_MCP_HANDOFF_GATE=true
# Early policy classification for executeCommand/filesystem/SSH nodes. off|warn|block.
# Downstream workflow validation remains fail-closed when this early gate is warn/off.
FORBIDDEN_NODE_GATE_MODE=block
# WS-J: non-core node gate. Workflows using node types outside the validated CORE set
# (e.g. googleSheets, slack) must be validated via a real n8n MCP handoff before deploy
# (stops the architect from guessing typeVersions). off | warn | block (default block).
NODE_VALIDATION_GATE_MODE=block
# Adaptive depth controller (depth-controller.ts) — default true in code.
FEATURE_ADAPTIVE_DEPTH=true
# Reflection repair pass (generate-with-harness.ts) — default true in code.
FEATURE_REFLECTION_REPAIR_PASS=true
# Graceful convergence: a delegating run that already holds a usable deliverable
# but keeps churning is forced to synthesize + stops cleanly (no timeout). Default true.
FEATURE_REFLECTOR_CONVERGENCE=true
# finalize-on-deliverable: once the Automation Golden Path reaches a terminal-for-brief
# deliverable (tested/active), the architect run ENDS with a final report instead of
# hanging to the delegation timeout. Fixes the clean-run hang that graceful convergence
# misses (convergence needs >=2 reflector interventions; a clean run has 0). Levers:
# deliverable-aware completion scorer + prepareStep force-report + stopWhen backstop.
# Automation-scoped (no-op for other agents). Default true; set false to revert.
FEATURE_AUTOMATION_FINALIZE_ON_DELIVERABLE=true
# loop_fix P1: generate-time model health gate (model-health-gate.ts). Before
# agent.generate() swaps an unhealthy (unavailable / circuit-open) model for the
# first healthy model in the agent's fallback chain, and records run outcomes
# into the circuit breaker. Default OFF (behaviour-preserving). Set true for live E2E.
FEATURE_MODEL_HEALTH_GATE=false
# E2E only: pin EVERY agent/worker generate() to this single model id (highest
# precedence over presets and the health gate). Leave empty in normal operation.
TEST_FORCE_MODEL=

# ── Self-heal cascade gating (error-collector.ts) ─────────────────────────────
# Transient LLM timeouts / reflector "unrecoverable" stops are operational
# signals, NOT code defects — they are recorded as a cycle observation but do NOT
# open a repo-maintenance coding cascade (which would itself just time out).
# Set true to restore the old always-escalate behavior.
ERROR_COLLECTOR_ESCALATE_TRANSIENT=false
# Extra transient patterns (case-insensitive regex) to never escalate; split on `|||`.
ERROR_COLLECTOR_TRANSIENT_PATTERNS=

# ── Credentials Registry (IDs z n8n UI) ───────────────────────────────────────
N8N_CREDENTIAL_TELEGRAM_ID=
N8N_CREDENTIAL_TELEGRAM_NAME=Telegram Bot
N8N_CREDENTIAL_MONGO_ID=
N8N_CREDENTIAL_MONGO_NAME=MongoDB
N8N_CREDENTIAL_GMAIL_ID=
N8N_CREDENTIAL_GMAIL_NAME=Gmail OAuth2
N8N_CREDENTIAL_GMAIL_TYPE=googleGmailOAuth2Api
N8N_CREDENTIAL_HTTP_ID=
N8N_CREDENTIAL_HTTP_NAME=HTTP Header Auth

# Telegram ID (używany przez n8n nodes)
N8N_TELEGRAM_CHAT_ID=

# ── Telegram Bot (bezpośrednia integracja) ───────────────────────────────────
# Token bota z @BotFather. Używany przez n8n webhook + bezpośrednie API.
TELEGRAM_BOT_TOKEN=
# Dozwolone chat IDs (lista oddzielona przecinkami). Ogranicza kto może pisać do agenta.
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Tavily (web search) ───────────────────────────────────────────────────────
# https://app.tavily.com
TAVILY_API_KEY=

# ── Firecrawl (web → markdown, OPCJONALNE) ───────────────────────────────────
# https://www.firecrawl.dev — klucz aktywuje MCP firecrawl (scrape/crawl) w researcherze.
# Bez klucza researcher używa Playwrighta jako fallback do deep-readu stron.
FIRECRAWL_API_KEY=

# ── Context7 (aktualna dokumentacja bibliotek, OPCJONALNE) ───────────────────
# https://context7.com — klucz zwiększa rate limity. Bez klucza działa z niższym limitem.
# Używany przez codingAgent do pobierania docs bibliotek w zewnętrznych projektach.
CONTEXT7_API_KEY=

# ── Google Maps / Places API (opinie restauracji, OPCJONALNE) ────────────────
# Google Cloud → włącz "Places API (New)" + billing. OSOBNY klucz od OAuth Gmaila.
# Bez klucza tool reviews_google_place degraduje do PSEV (TripAdvisor/blogi przez researchera).
GOOGLE_MAPS_API_KEY=

# ── Design Agent / huashu-design scripts (OPTIONAL) ──────────────────────────
# Override only when Mastra runs from a cwd where storage/repos_external cannot be
# resolved automatically. Defaults to ./storage/repos_external/huashu-design.
DESIGN_SKILL_ROOT=
# Output directory scanned by dashboard-ui Workspace → Designer. When unset, the
# dashboard scans ./design-work, ./src/mastra/public/design-work, and design-demos.
DESIGN_OUTPUT_DIR=

# ── Filmmaker Agent / Seedance remote generation (OPTIONAL) ──────────────────
# Local copy of the Seedance reference corpus. Defaults to src/mastra/_skills/film
# and falls back to storage/repos_external/seedance-2.0 for Python validators.
FILM_SKILLS_ROOT=
FILM_SKILL_ROOT=
# Output directory for generated MP4s and last-frame images. Relative paths are
# resolved from the agentic-agents cwd.
FILM_OUTPUT_DIR=film-work
# First paid remote generation requires system_request_approval unless set false.
FILM_REQUIRE_APPROVAL=true
# Hard caps on PAID generations per clip/project (code-enforced loop guard). Once
# reached, film_generate returns terminal paid_generation_cap_reached. Set 0 to disable.
FILM_MAX_PAID_GENERATIONS_PER_CLIP=3
FILM_MAX_PAID_GENERATIONS_PER_PROJECT=12
FILM_SURFACE=fal
# fal.ai Seedance surface. Keep empty until you intentionally run paid generation.
FAL_KEY=
FAL_BASE_URL=https://queue.fal.run
FILM_FAL_MODEL_ID=bytedance/seedance-2.0/text-to-video
# Image/video-driven modes (I2V/FLF2V/R2V/V2V) must use an image-to-video model.
FILM_FAL_IMAGE_MODEL_ID=bytedance/seedance-2.0/image-to-video
FILM_FAL_SUBMIT_PATH=
FILM_POLL_INTERVAL_MS=5000
FILM_POLL_TIMEOUT_MS=600000
# Reserved for future Veo/Runway/Volcengine adapters. v1 fails closed for Veo.
RUNWAY_API_KEY=
RUNWAY_BASE_URL=
FILM_RUNWAY_MODEL_ID=seedance2
ARK_API_KEY=
ARK_BASE_URL=
FILM_ARK_MODEL_ID=doubao-seedance-2-0

# ── Musician domain (music/song/audio generation, OPTIONAL) ──────────────────
# Output directory for generated audio takes. Relative paths resolve from the
# agentic-agents cwd.
MUSIC_OUTPUT_DIR=music-work
# First paid remote generation requires system_request_approval unless set false.
MUSIC_REQUIRE_APPROVAL=true
# Hard caps on PAID generations per track/project (code-enforced loop guard). Once
# reached, music_generate returns terminal paid_generation_cap_reached. Set 0 to disable.
MUSIC_MAX_PAID_GENERATIONS_PER_TRACK=3
MUSIC_MAX_PAID_GENERATIONS_PER_PROJECT=12
# Default surface: fal | fal-ace-step | fal-stable-audio | fal-minimax-reference | elevenlabs | suno-gateway.
MUSIC_SURFACE=fal
# fal.ai default text/lyrics-to-audio surface (async submit/poll). Reuses FAL_KEY / FAL_BASE_URL above.
# fal/minimax requires reference audio; use MUSIC_FAL_MINIMAX_MODEL_ID for that surface.
MUSIC_FAL_MODEL_ID=fal-ai/ace-step
MUSIC_FAL_SUBMIT_PATH=
MUSIC_FAL_ACE_STEP_MODEL_ID=fal-ai/ace-step
MUSIC_FAL_ACE_STEP_SUBMIT_PATH=
MUSIC_FAL_STABLE_AUDIO_MODEL_ID=fal-ai/stable-audio
MUSIC_FAL_STABLE_AUDIO_SUBMIT_PATH=
MUSIC_FAL_MINIMAX_MODEL_ID=fal-ai/minimax-music
MUSIC_FAL_MINIMAX_SUBMIT_PATH=
MUSIC_FAL_STABLE_AUDIO_STEPS=100
# ElevenLabs Music surface (SYNCHRONOUS — POST /v1/music returns audio bytes).
# Reuses ELEVENLABS_API_KEY above. Default base url is https://api.elevenlabs.io.
ELEVENLABS_BASE_URL=
MUSIC_ELEVENLABS_MODEL_ID=music_v1
MUSIC_ELEVENLABS_SUBMIT_PATH=
# Suno gateway seam — ToS-compliant env-swappable gateway ONLY, never a scraper.
# Disabled unless SUNO_GATEWAY_BASE_URL is set.
SUNO_GATEWAY_BASE_URL=
SUNO_GATEWAY_API_KEY=
MUSIC_SUNO_MODEL_ID=suno-v5
MUSIC_SUNO_SUBMIT_PATH=
# Shared poll cadence for async surfaces (fal + suno-gateway).
MUSIC_POLL_INTERVAL_MS=5000
MUSIC_POLL_TIMEOUT_MS=600000

# ── Drafts store (social posts + cold-email, OPTIONAL) ───────────────────────
# Where the DraftsStore persists generated drafts ({date}/{taskId}/{draftId}).
# The draft-registry indexes this dir into Mongo for workspace-ui. Keep it under
# src/mastra/public/.drafts so the same path is used regardless of process cwd.
DRAFTS_PATH=
# ── Content Pack (contentAgent on-disk working documents, OPTIONAL) ──────────
# Directory where contentAgent writes Content Packs (<projectId>.md).
# Defaults to /projekty/Jarvis-Projects/content-packs when unset.
CONTENT_DOCS_DIR=

# ── Chef / Menu Book (on-disk documents, OPTIONAL) ───────────────────────────
# Directory where chefAgent writes Menu Books (<projectId>.md).
# Defaults to /projekty/Jarvis-Projects/menu-books when unset.
CHEF_DOCS_DIR=
# Three PLN thresholds for priceRange.tier (budget/mid/premium/luxury). Default 35,70,130.
CHEF_PRICE_TIER_PLN=
# Chrome/Chromium binary used by chef_document_pdf (E3). Default google-chrome-stable.
CHEF_CHROME_BIN=
# ── Molecular flavor pairing (reasoning layer, A/B toggle) ──
# When ON, registers the chef_score_pairing / chef_suggest_pairings tools and injects
# a computed `flavorAudit` (shared-compound overlap, cuisine-aware) into chef_generate_menu.
# When OFF (default), the chef relies purely on qualitative domain.md + NotebookLM rules —
# flip this to compare menu quality before/after, then keep whichever you prefer.
# The offline data scripts (build:flavor-aliases, enrich:recipe-flavor) run
# regardless of the flag — the flag only gates RUNTIME use of that data by the agent.
# Accepts 1/true/yes/on or 0/false/no/off. Default: off.
CHEF_FLAVOR_PAIRING_ENABLED=false

# ── Recon cost guards (E3, R4 — daily request budgets, OPTIONAL) ──────────────
# Daily request caps for metered recon providers; the BudgetTracker degrades to the
# researcher / skips once exhausted. Set to 0 to disable a cap.
TAVILY_DAILY_LIMIT=
PLACES_DAILY_LIMIT=
FIRECRAWL_DAILY_LIMIT=

# ── Ollama (lokalny LLM, opcjonalnie) ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Domyślny model Ollama dla integracji, które jawnie czytają ten override
# (np. gemma4:12b; główne mapowanie modeli aplikacji jest w model-manifest.ts).
OLLAMA_DEFAULT_MODEL=
# Placeholder API key (Ollama nie wymaga, ale AI SDK provider go oczekuje)
OLLAMA_API_KEY=ollama

# ── Embedder (Pattern RAG, chef notes) ───────────────────────────────────────
# Provider: ollama (lokalny, domyślny) | google
EMBEDDING_PROVIDER=
# Dla ollama: bge-m3 (1024 dim, multilingual PL/EN) lub nomic-embed-text (768 dim).
# Dla google: text-embedding-005.
EMBEDDING_MODEL=
# Process-wide throttle + retry for local Ollama embeddings (chroni runner bge-m3
# przed burstem SkillRegistry + MemoryExtractor na starcie). Default 2 / 3.
EMBEDDING_CONCURRENCY=
EMBEDDING_MAX_RETRIES=

# ── NotebookLM CLI (opcjonalnie) ─────────────────────────────────────────────
# Ścieżka do binarki nlm, np. /usr/local/bin/nlm
NLM_BINARY_PATH=nlm
# Domyślny notebook UUID (używany gdy nie podano innego)
NLM_DEFAULT_NOTEBOOK=

# ── GitHub Integration (Etap 9) ──────────────────────────────────────────────
# Personal Access Token z GitHub (scope: repo)
GITHUB_TOKEN=
# Owner i repo name
GITHUB_OWNER=turboMe
GITHUB_REPO=mastra-agentic-agents-blue-green-autohealing-system
# true = po approve tworzony jest PR na GitHubie, false = lokalny merge (legacy)
GITHUB_PR_MODE=false
# true = auto-merge po CI green, false = czeka na human approval na GH
GITHUB_AUTO_MERGE=false

# ── Automation Architect — reguły bezpieczeństwa ──────────────────────────────
# Master switch — wyłącza cały Automation Architect (default: true)
AUTOMATION_ARCHITECT_ENABLED=true
# Nowe workflowy tworzone w trybie dry-run (nie aktywują się automatycznie)
AUTOMATION_ARCHITECT_DRY_RUN_DEFAULT=true
# Wymaga approval przed aktywacją/modyfikacją workflowów
AUTOMATION_ARCHITECT_REQUIRE_APPROVAL=true
# Maksymalna liczba prób naprawy workflowu (default: 3)
AUTOMATION_MAX_FIX_ATTEMPTS=3
# Strefa czasowa dla cron schedules (default: Atlantic/Reykjavik)
AUTOMATION_DEFAULT_TIMEZONE=Atlantic/Reykjavik
# Blokowane kategorie operacji w generowanych workflowach:
AUTOMATION_BLOCK_EXECUTE_COMMAND=true
AUTOMATION_BLOCK_FILE_SYSTEM=true
AUTOMATION_BLOCK_SSH=true
AUTOMATION_BLOCK_PRODUCTION_DB_WRITES=true
AUTOMATION_BLOCK_MASS_EMAIL=true
AUTOMATION_BLOCK_PUBLIC_POSTING=true
# Pozwól MCP tools w generowanych workflowach (default: false — conservative)
AUTOMATION_ALLOW_MCP=false

# ── Meta Agent ────────────────────────────────────────────────────────────────
# Maksymalna liczba kroków na jedno wywołanie meta agenta
META_AGENT_MAX_STEPS=40
# Timeout synchroniczny dla delegacji (ms)
META_AGENT_SYNC_TIMEOUT_MS=45000

# ── Parallel coding dispatch (J2) ────────────────────────────────────────────
# One shared wave cap for local and cloud subtasks (default: 3).
J2_DISPATCH_CONCURRENCY=3

# ── Mastra / Dashboard ───────────────────────────────────────────────────────
# Port na którym startuje mastra dev (domyślnie 4111)
PORT=4111
NODE_ENV=development
# Poziom logowania: debug | info | warn | error
LOG_LEVEL=info

# ── Transient Tool Shelf hotfix ──────────────────────────────────────────────
# Request-scoped tool search/load/release while the durable Capability Broker
# is developed. Default ON for agents that attach the processor.
# Emergency rollback: set to false and restart Mastra.
FEATURE_INTERIM_TOOL_SHELF=true
# Empty or * = all attached agents; otherwise comma-separated runtime Agent.id values.
INTERIM_TOOL_SHELF_AGENTS=*
# Optional global budgets (positive integers).
INTERIM_TOOL_SHELF_INITIAL_TOP_K=4
INTERIM_TOOL_SHELF_MAX_ACTIVE=8
INTERIM_TOOL_SHELF_SEARCH_TOP_K=6

# Transient Skill Shelf
# Request-scoped semantic search plus load/list/swap/release. Default ON only
# for agents that explicitly attach the processor. Legacy skill_search and
# skill_load remain registered for immediate flag rollback.
FEATURE_INTERIM_SKILL_SHELF=true
# Empty or * = all attached agents; otherwise comma-separated runtime Agent.id values.
INTERIM_SKILL_SHELF_AGENTS=*
# Optional global budgets. Agent-specific profiles apply when these are omitted.
# INTERIM_SKILL_SHELF_MAX_ACTIVE=2
# INTERIM_SKILL_SHELF_MAX_CHARS=36000
# INTERIM_SKILL_SHELF_SEARCH_TOP_K=5
# INTERIM_SKILL_SHELF_MIN_SCORE=0.25

# ── Task Ledger (Etap 1 — IDEALSYSTEMMASTERPLAN) ──────────────────────────────
# Rollback switch for the whole ledger layer (default ON when unset)
FEATURE_LEDGER_V1=true
# n8n webhook that forwards lane state changes (blocked/awaiting_approval/done/failed)
# to Telegram. Leave empty to disable push.
LEDGER_PUSH_WEBHOOK_URL=

# ── Feature flags dodane w E3/E5/E6/E8 (wszystkie default ON w kodzie) ─────────
# Rollback = ustaw na false. Nie trzeba ich mieć w .env — kod domyślnie ON.
FEATURE_COMM_CONTRACTS=true      # E3: artifact store + TaskBrief v2 + ResultEnvelope
FEATURE_LEDGER_SCHEDULER=true    # E5: claims lease/lock (serializacja kolizji)
FEATURE_IDEMPOTENCY=true         # E5: dedup efektów ubocznych przy retry
FEATURE_SKILL_DISTILLATION=true  # E6: destylacja skilli po sukcesie (success brain)
FEATURE_GRAPHIFY=true            # E8: graphify_affected/explain/god_nodes (degraduje bez grafu)

# ── Graphify (E8 — mapa wpływu kodu) ──────────────────────────────────────────
# Ścieżka do izolowanego CLI graphify (venv POZA repo). Instalacja:
#   python3 -m venv ~/.venvs/graphify && ~/.venvs/graphify/bin/pip install graphifyy==0.9.22
# Potem: npm run graph:build (zbuduj graf raz). Puste = tool degraduje się do code_search.
GRAPHIFY_BIN=

# ── Delegation hardening (ideas/delegation-depth-hardening-plan.md) ───────────
# Wszystkie trzy flagi default ON w kodzie — rollback = ustaw na false.
FEATURE_DEPTH_THREAD_INHERITANCE=true      # P1: "Deleguj"/"dalej" dziedziczy głębokość wątku (sticky depth)
FEATURE_DELEGATION_BUDGET_COORDINATION=true # P2: timeout dziecka <= pozostały budżet rodzica + auto-async
FEATURE_DELEGATION_TIMEOUT_SALVAGE=true    # P3: timeout delegacji zwraca wskaźnik salvage (odzysk pracy)
# P2 — rezerwa rodzica: ile czasu zostaje MU na przyjęcie wyniku I sformułowanie
# odpowiedzi po powrocie dziecka (ms). Musi pokryć jeden zamykający krok modelu
# plus pracę po runie (auto_review = 40 s przy depth `critical`). Było 20000 —
# za mało: 2026-08-24 dziecko dostało 320.867 s z 341 s, metcie zostało 18 s,
# run padł na zegarze i caller dostał HTTP 504 z pustym body, mimo że gotowy
# workflow stał w n8n od 8 minut. Niezmiennik: parentRemaining − childGrant >= ta wartość.
DELEGATION_SYNC_SAFETY_MARGIN_MS=120000
# P2 — poniżej tego okna delegacja sync jest bez sensu -> auto-przełączenie na async (ms)
DELEGATION_MIN_VIABLE_SYNC_MS=60000

# ── GastroBridge-Consulting Integration (/wiedza + formularze) ───────────────
# Klucz autoryzacyjny API Bearer Token dla publikacji artykułów (/wiedza) oraz pobierania leadów/kandydatów/audytów
AGENT_API_SECRET=
# URL endpointu API konsultingu (domyślnie: https://consulting.gastrobridge.com/api/wiedza)
CONSULTING_API_URL=https://consulting.gastrobridge.com/api/wiedza

# ── ComfyUI Local Visual Studio (SPLOT OS) ──────────────────────────────────
# Sterowanie automatycznym uruchamianiem ComfyUI w launcherze Splot.sh (true/false)
COMFYUI_AUTOSTART=true
# Adres API lokalnego serwera ComfyUI (domyślnie: http://localhost:8188)
COMFYUI_API_URL=http://localhost:8188
# Katalog główny zapisu wygenerowanych grafik i metadanych sidecar .json
COMFYUI_OUTPUT_ROOT=/projekty/Jarvis-Projects/media/generations
# Ścieżka do bazowego szablonu workflow (txt2img z LoRA i auto-face detailer)
COMFYUI_WORKFLOW_TEMPLATE=/vm/ComfyUI/user/default/workflows/txt2img - najlepszy (2 twarze AUTO-PŁEĆ).json
# Czas oczekiwania (w sekundach) po opróżnieniu kolejki przed automatycznym zwolnieniem VRAM (POST /free)
COMFYUI_VRAM_RELEASE_DELAY_SEC=60


